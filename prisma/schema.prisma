generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id        String @id
  login     String @db.VarChar(36)
  password  String @db.VarChar(36)
  version   Int
  createdAt String
  updatedAt String
}

model tracks {
  id       String   @id
  name     String
  artistId String?
  albumId  String?
  duration Int
  albums   albums?  @relation(fields: [albumId], references: [id], onUpdate: NoAction, map: "fk_track_album")
  artists  artists? @relation(fields: [artistId], references: [id], onUpdate: NoAction, map: "fk_track_artist")
}

model artists {
  id     String   @id
  name   String
  grammy Boolean
  albums albums[]
  tracks tracks[]
}

model albums {
  id       String   @id
  name     String
  year     Int
  artistId String?
  artists  artists? @relation(fields: [artistId], references: [id], onUpdate: NoAction)
  tracks   tracks[]
}
