generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id        String @id
  login     String @db.VarChar(36)
  password  String
  version   Int
  createdAt String
  updatedAt String
}

model tracks {
  id              String           @id
  name            String
  artistId        String?
  albumId         String?
  duration        Int
  favorite_tracks favorite_tracks?
  albums          albums?          @relation(fields: [albumId], references: [id], onUpdate: NoAction, map: "fk_track_album")
  artists         artists?         @relation(fields: [artistId], references: [id], onUpdate: NoAction, map: "fk_track_artist")
}

model artists {
  id               String            @id
  name             String
  grammy           Boolean
  albums           albums[]
  favorite_artists favorite_artists?
  tracks           tracks[]
}

model albums {
  id              String           @id
  name            String
  year            Int
  artistId        String?
  artists         artists?         @relation(fields: [artistId], references: [id], onUpdate: NoAction)
  favorite_albums favorite_albums?
  tracks          tracks[]
}

model favorite_albums {
  id     String @id
  albums albums @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model favorite_artists {
  id      String  @id
  artists artists @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model favorite_tracks {
  id     String @id
  tracks tracks @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
